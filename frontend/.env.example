VITE_GOOGLE_MAPS_API_KEY=

# Google Sign-In (LoginPage). Same value as the backend's GOOGLE_CLIENT_ID - never a client
# secret (none is used anywhere in this app's Google Sign-In flow). Blank keeps the Google button
# disabled with an explanatory tooltip rather than attempting to initialize Google Identity
# Services with no client ID. See docs/google-login.md.
VITE_GOOGLE_CLIENT_ID=

# Production-only (Vercel). Absolute origins of the two standalone Render backends - there is no
# runtime gateway in that architecture, so the frontend calls each service directly and CORS
# (not a rewrite) is what makes it work. Leave BOTH blank for local dev: axiosClient/
# authAxiosClient then fall back to the relative '/api/v1' path already routed by the Vite dev
# proxy to the local api-gateway (see vite.config.ts) - nothing else changes locally.
# See docs/FREE_DEPLOYMENT_ARCHITECTURE.md and docs/ENVIRONMENT_VARIABLES.md.
VITE_AUTH_API_URL=
VITE_BACKEND_API_URL=
