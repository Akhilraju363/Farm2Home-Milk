VITE_GOOGLE_MAPS_API_KEY=

# Google Sign-In (LoginPage). Same value as the backend's GOOGLE_CLIENT_ID - never a client
# secret (none is used anywhere in this app's Google Sign-In flow). Blank keeps the Google button
# disabled with an explanatory tooltip rather than attempting to initialize Google Identity
# Services with no client ID. See docs/google-login.md.
VITE_GOOGLE_CLIENT_ID=
