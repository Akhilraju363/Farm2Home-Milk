<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.farm2home</groupId>
    <artifactId>farm2home-milk</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Farm2Home Milk - Parent</name>
    <description>Enterprise Dairy Farm Management and Milk Delivery Platform</description>

    <modules>
        <module>shared-libs</module>
        <module>discovery-service</module>
        <module>config-server</module>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>customer-service</module>
        <module>subscription-service</module>
        <module>order-service</module>
        <module>payment-service</module>
        <module>delivery-service</module>
        <module>farm-service</module>
        <module>invoice-service</module>
        <module>production-service</module>
        <module>inventory-service</module>
        <module>notification-service</module>
        <module>dashboard-service</module>
        <module>reports-service</module>
        <!-- spike/render-single-jvm ONLY: throwaway single-JVM aggregation spike (farm + production).
             Remove this line before merging anything to main. -->
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2023.0.0</spring-cloud.version>
        <jjwt.version>0.13.0</jjwt.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.32</lombok.version>
        <flyway.version>10.4.1</flyway.version>
        <testcontainers.version>1.20.1</testcontainers.version>
        <springdoc.version>2.3.0</springdoc.version>
        <jacoco.version>0.8.11</jacoco.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SecurityMockMvcRequestPostProcessors etc. for @WebMvcTest controller tests that
             need to inject a custom (@AuthenticationPrincipal) principal into the request. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- ===================================================================
                 P1-1 single-JVM aggregation: every business service applies
                 spring-boot-maven-plugin, so its MAIN `*.jar` is a Boot executable
                 (fat) jar with classes under BOOT-INF/classes/ - fine for `java -jar`
                 and the per-service Dockerfiles, but unusable as a normal library on
                 the `app` module's compile/test/runtime classpath (its @ComponentScan
                 / @EnableJpaRepositories would find nothing).

                 This adds a SECOND, thin, classified artifact `*-lib.jar` (plain
                 `target/classes`, no fat packaging) that `backend/app` consumes via
                 `<classifier>lib</classifier>`. The main `*.jar` is untouched - it is
                 still fattened by spring-boot:repackage afterwards - so standalone
                 service packaging and every existing Dockerfile keep working exactly
                 as before. This is the Spring Boot reference approach ("Use the
                 repackaged jar as a dependency"), just with the classifier on the
                 library copy instead of the executable copy so nothing else changes.

                 Excludes below keep each service's own runtime config OUT of the
                 aggregated app: application*.yml (service ports / eureka / per-service
                 profiles), logback-spring.xml, bootstrap*.yml, and db/migration/**
                 (the app runs its own per-schema Flyway from copied locations - a
                 merged classpath:db/migration would collide on V1/V2/...).

                 skipIfEmpty => pom modules (parent, shared-libs parent) and any
                 classless module simply don't produce a -lib.jar.
                 =================================================================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>library-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>lib</classifier>
                            <skipIfEmpty>true</skipIfEmpty>
                            <excludes>
                                <exclude>application*.yml</exclude>
                                <exclude>application*.yaml</exclude>
                                <exclude>application*.properties</exclude>
                                <exclude>bootstrap*.yml</exclude>
                                <exclude>bootstrap*.properties</exclude>
                                <exclude>logback-spring.xml</exclude>
                                <exclude>db/migration/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- In <build><plugins> (not pluginManagement) so every module is instrumented
                 automatically - previously this was pluginManagement-only, which meant a
                 module had to re-declare the plugin itself to get coverage at all, and only
                 auth-service and customer-service did. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- Entry point only invoked reflectively at startup; not meaningfully
                             unit-testable, and its JPA/scheduling annotations already moved out
                             to a separate JpaConfig for @WebMvcTest slice compatibility. -->
                        <exclude>**/*Application.class</exclude>
                        <!-- Plain data holders (Lombok-generated accessors, no logic). -->
                        <exclude>**/dto/**</exclude>
                        <exclude>**/domain/entity/**</exclude>
                        <exclude>**/domain/enums/**</exclude>
                        <!-- Cross-service dashboard/report/analytics response DTOs (common-core) -
                             same rationale as **/dto/** above, just different package names since
                             these are shared response shapes rather than one service's own DTOs.
                             Scoped to the exact common-core path (not a bare **/reports/** or
                             **/analytics/**) since those bare patterns would also match
                             reports-service's/other services' own package roots, which do have
                             real logic. -->
                        <exclude>**/common/core/dashboard/**</exclude>
                        <exclude>**/common/core/reports/**</exclude>
                        <exclude>**/common/core/analytics/**</exclude>
                        <!-- Spring Data interfaces - no method bodies to cover. -->
                        <exclude>**/domain/repository/**</exclude>
                        <!-- Bean wiring / security filter chains - exercised indirectly through
                             @WebMvcTest controller slices (which @Import the real SecurityConfig)
                             rather than tested as units in their own right. -->
                        <exclude>**/config/**</exclude>
                        <!-- Thin exception types with no behavior beyond their constructor. -->
                        <exclude>**/exception/**</exclude>
                        <!-- Mapper interfaces (hand-written default methods and MapStruct's
                             generated Impl alike). Service tests always mock the Mapper
                             dependency, so the real implementation never actually executes
                             under a service unit test; the mapping logic itself was validated
                             live against real data during its own implementation, not by
                             invoking the mocked interface here. -->
                        <exclude>**/mapper/**</exclude>
                        <!-- Kafka producers/consumers are thin publish/consume wrappers around
                             already-tested service logic. -->
                        <exclude>**/kafka/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Bound to verify (not test) so a plain "mvn test" during development
                         still runs fast without failing the build; "mvn verify"/"mvn install"
                         enforces the coverage bar. A bundle left with zero coverable
                         instructions after the excludes above (e.g. discovery-service,
                         config-server) trivially satisfies any ratio and never fails this. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <!-- Writes META-INF/build-info.properties into the jar so the /info
                             actuator endpoint reports real name/version/build-time instead of
                             an empty {} - every child inherits this execution automatically
                             since they all reference this plugin without their own executions. -->
                        <execution>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
