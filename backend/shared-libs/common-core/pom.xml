<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.farm2home</groupId>
        <artifactId>shared-libs</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-core</artifactId>
    <name>Farm2Home - Common Core</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- For the AuditLog entity/repository; every consuming service already brings the
             real JPA/Hibernate runtime via spring-boot-starter-data-jpa. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- So AuditLogService can auto-populate correlationId from MDC without every caller
             having to pass it explicitly. -->
        <dependency>
            <groupId>com.farm2home</groupId>
            <artifactId>common-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- AuditAspect (@Audited) needs aspectjweaver on the classpath at runtime, not just for
             compiling common-core - kept as a normal (compile-scope) dependency so it flows
             transitively into every consuming service instead of requiring 9 separate pom edits.
             Spring Boot's own AopAutoConfiguration auto-enables proxying once this is present,
             no @EnableAspectJAutoProxy needed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- For AuditLogService/AuditHttpContext to read the current HttpServletRequest
             (ip/uri/method, gateway identity headers). "provided" since every real consuming
             service already brings the servlet/web runtime via spring-boot-starter-web,
             matching the spring-boot-starter-data-jpa pattern below. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- For @Schema examples/descriptions on shared response DTOs (reports/dashboard/analytics
             packages) so springdoc renders them for every consuming service's endpoints. "provided"
             since every real consuming service already brings the full springdoc-openapi runtime
             (which includes this transitively) via its own pom - matching the pattern above. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.19</version>
            <scope>provided</scope>
        </dependency>
        <!-- Integration testing support with Testcontainers -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot test and security test for integration tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Cross-service workflow test that extends BaseIntegrationTest (@SpringBootTest),
                             but this library module has no @SpringBootApplication, so its context can never
                             start here ("Unable to find a @SpringBootConfiguration"). BaseIntegrationTest
                             itself is consumed by order/payment/delivery via this module's test-jar, so it
                             stays in the jar; only running this one class in common-core is skipped. It needs
                             to move into (or be rewritten for) a module that has an application class. -->
                        <exclude>**/EndToEndWorkflowIntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
