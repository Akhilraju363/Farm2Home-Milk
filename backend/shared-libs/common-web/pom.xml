<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.farm2home</groupId>
        <artifactId>shared-libs</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-web</artifactId>
    <name>Farm2Home - Common Web</name>

    <dependencies>
        <!-- Gives GlobalExceptionHandler access to RequestTraceIdFilter.CORRELATION_ID_HEADER /
             MDC_CORRELATION_ID so the header name has one source of truth instead of being
             duplicated as a string literal here too. Every service depending on common-web
             already depends on common-observability directly as well. -->
        <dependency>
            <groupId>com.farm2home</groupId>
            <artifactId>common-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Only needed to reference org.springframework.dao.DataAccessException in
             GlobalExceptionHandler; every service that depends on common-web already
             brings spring-tx transitively via spring-boot-starter-data-jpa. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
