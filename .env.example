POSTGRES_USER=farm2home
POSTGRES_PASSWORD=farm2home@123
POSTGRES_DB=farm2home

EUREKA_USERNAME=eureka
EUREKA_PASSWORD=eurekaSecret

CONFIG_USERNAME=configuser
CONFIG_PASSWORD=config@secret

JWT_SECRET=ZmFybTJob21lLXNlY3JldC1rZXktbXVzdC1iZS1hdC1sZWFzdC0yNTYtYml0cy1sb25n

# Email (notification-service). EMAIL_ENABLED=false (default) sends every email through the
# built-in logging provider instead - just logs it, no SMTP connection attempted, no credentials
# required, and what every automated test runs against (same "logging by default" shape as
# SMS_PROVIDER/PUSH_PROVIDER below). Set EMAIL_ENABLED=true to actually send: MAIL_HOST/MAIL_PORT
# default to Mailtrap's shared sandbox host, which will reject auth without real credentials -
# sign up at mailtrap.io (free) and paste your sandbox inbox's SMTP username/password below to
# receive test emails without risk of mailing a real customer address.
# To use Gmail SMTP instead: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, and an App Password
# (not your regular Gmail password) for MAIL_PASSWORD.
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=Farm2Home
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_MILLIS=150
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@farm2homemilk.example

# Payment gateway (payment-service). Defaults to the built-in mock provider, which needs no
# credentials and is what every automated test runs against — safe to leave everything below
# blank. Set PAYMENT_GATEWAY_PROVIDER=razorpay and fill in the three RAZORPAY_* values from your
# Razorpay dashboard (Settings > API Keys for the key pair, Settings > Webhooks for the webhook
# secret) to process real payments. Never commit real values here — this file only ships defaults
# and empty placeholders.
PAYMENT_GATEWAY_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS provider (auth-service for OTP; notification-service for order/delivery/payment SMS).
# Defaults to the built-in logging provider, which just logs the message instead of sending it -
# no credentials required, and what every automated test runs against. Set SMS_PROVIDER to a
# future real provider's own property value once one is added (see
# docs/PAYMENT_GATEWAY_INTEGRATION.md's Razorpay section for the same pattern applied to payments).
SMS_PROVIDER=logging
SMS_MAX_ATTEMPTS=3
SMS_RETRY_BACKOFF_MILLIS=150

# Push notification provider (notification-service: Order Updates, Delivery Status, Payment
# Confirmation, Subscription Alerts). Same defaults/rationale as SMS above - the logging provider
# needs no credentials and is what every automated test runs against.
PUSH_PROVIDER=logging
PUSH_MAX_ATTEMPTS=3
PUSH_RETRY_BACKOFF_MILLIS=150

# Mobile OTP login/registration (auth-service). Applies uniformly to every OTP purpose
# (REGISTRATION/LOGIN/FORGOT_PASSWORD) - see docs/mobile-otp-login.md. Safe defaults; no
# credentials involved (OTP delivery itself reuses SMS_PROVIDER above).
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=3

# Google Sign-In (auth-service + frontend). Blank (default) disables Google Sign-In entirely -
# the backend fails closed (401 "Google Sign-In is not configured"), and the frontend keeps the
# Google button disabled. Create an OAuth 2.0 Client ID (Web application) in the Google Cloud
# Console (APIs & Services > Credentials), add this app's origin(s) under "Authorized JavaScript
# origins", and paste the client ID (NOT a client secret - none is used anywhere in this codebase,
# see docs/google-login.md) into both variables below. GOOGLE_CLIENT_ID is backend-only (used to
# verify the ID token's audience); VITE_GOOGLE_CLIENT_ID is the same value, safe to ship to the
# frontend (see frontend/.env.example).
GOOGLE_CLIENT_ID=
