# ========================
.docker/

# ========================
# IDE
# ========================
.idea/
*.iml
*.iws
*.ipr
# .vscode/ is ignored except settings.json, which holds shared, non-machine-specific
# workspace config (e.g. Java build update mode) that's useful for every contributor.
.vscode/*
!.vscode/settings.json
*.swp
*.swo
*~

# ========================
# OS
# ========================
.DS_Store
Thumbs.db
desktop.ini

# ========================
# Logs
# ========================
*.log
logs/

# ========================
# Uploaded files (keep the directory structure, not the content)
# ========================
uploads/*/*
!uploads/*/.gitkeep
# Each service's own local file-storage working directory (runtime-created, not the tracked
# top-level uploads/ placeholder structure above) - never commit uploaded content.
backend/*/uploads/

# ========================
# Scratch / working files
# ========================
.scratch/

# ========================
# Test / Coverage
# ========================
.jacoco/
jacoco.exec
coverage/

# ========================
# Terraform
# ========================
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup
infrastructure/terraform/*.tfvars
infrastructure/terraform/.terraform.lock.hcl
